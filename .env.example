# ==============================================================================
# Instagram İçerik Stüdyosu - Netlify Ortam Değişkenleri (.env.example)
# ==============================================================================
# Bu dosyadaki değişkenleri Netlify Dashboard üzerinde:
# Site Settings > Environment Variables bölümüne ekleyiniz.
# Yerel geliştirme için bu dosyayı `.env` olarak kopyalayabilirsiniz.
# ==============================================================================

# 1. Giriş Kullanıcı Adı
APP_USERNAME=admin

# 2. Şifre Hash'i (bcrypt hash formatında)
# Örnek: 'resimstudyosu2026' şifresi için bcrypt hash örneği:
# (Uygulamanın Ayarlar sekmesindeki 'Şifre Hash Üretici' ile kendi güvenli hash'inizi kolayca oluşturabilirsiniz)
APP_PASSWORD_HASH=$2a$10$wE8w99xK9R3YyQkQv0d5xO.XjKkK71gRqmBv9k77A8sY99JzB90la

# 3. Google Gemini API Anahtarı
# https://aistudio.google.com/ adresinden temin edebilirsiniz.
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 4. Oturum Güvenlik Gizli Anahtarı (JWT/HMAC için minimum 32 karakterlik rastgele metin)
SESSION_SECRET=art_studio_secure_jwt_session_secret_2026_super_safe_key_99
